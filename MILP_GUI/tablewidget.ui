}
.QWidget {
	margin: 5px;
}
QTabBar::tab:hover {
    color:  #51FDBA;
}
QWidget#tab,
QWidget#tab_2 {
    background-color: #002949;
}
QWidget#TableWidget{
background: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0   #0C0C31,     
        stop:0.5 #06032E,     
        stop:1   #0C0C31     
    );	
}

QTabWidget::pane {
  border: 1px solid #002949;
  top:-1px; 
  background: #002949;
} 

QTabBar::tab {
  background: #041c3d; 
  border: 1px solid #041c3d; 
  /* Round only the top-left and top-right corners */
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;

    /* Make bottom corners square */
    border-bottom-right-radius: 0px;
    border-bottom-left-radius: 0px;
  padding: 15px;
} 

QTabBar::tab:selected { 
  background: #002949; 
  margin-bottom: -1px; 
}
.QWidget {
	background-color: #091539;
}

QLineEdit,  QGroupBox {
    background-color: #041c3d;
    color: #ffffff;
    border: 1px solid #2a628f;
    padding: 8px 4px;
    border-radius: 4px;
}
QPushButton {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #51FCBB,
        stop:1 #4EE5D9
    );
    color: #000000;
    font-weight: bold;
    border: none;
    border-radius: 5px;
    padding: 5px 15px;
	margin: 5px;
}

QPushButton:hover {
    background-color: #CBFEEF
}

QSlider::handle{
 background-color: #45CACB;
}

QSlider::handle:hover{
 background-color: #51FDBA;
}


QComboBox QAbstractItemView {
   background-color: #041c3d;
   color: #ffffff;
   border: 1px solid #2a628f;
   padding: 8px;
   border-radius: 4px;
   selection-background-color: #555;
   selection-color: #fff;
	outline: 0;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #15415A;
	outline: 0;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #15415A;
	outline: 0;
	
}

QRadioButton::hover {
color: #51FDBA;
}


QLineEdit:disabled  {
    color: #45CACB;
}
QLabel:disabled QLabel {
     color: #45CACB;
}
QSpinBox, QDateEdit, QTimeEdit, QComboBox{
    background-color: #002949;
    color: #ffffff;
    padding: 5px 15px;
}
QSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QComboBox:hover {
    color: #51FDBA;
}

QTableView, QTableWidget {
    background-color:  #041c3d;
          /* Table body */
    gridline-color: transparent;        /* Hide grid lines if desired */
}

QHeaderView::section {
    background-color: #041c3d;          /* Header sections */
    color: white;                       /* Header text color for good contrast */
    border: none;                       /* Remove default header borders */
}

QTableCornerButton::section {
    background-color:#041c3d;         /* Top-left corner area */
    border: none;
}
QTableWidget, QTableView {
    border: 2px solid #45CACB;       /* Light teal border around the entire table */
	border-radius: 5px;
    gridline-color: #45CACB;         /* Match the grid lines to the border color for consistency */
}

