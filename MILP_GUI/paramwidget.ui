  <property name="styleSheet">
   <string notr="true">QWidget {
    color: #ffffff;
}
.QWidget {
	margin: 5px;
}
QWidget#ParamWidget{
background: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0   #0C0C31,     
        stop:0.5 #06032E,     
        stop:1   #0C0C31     
    );	
}
QMainWindow {
background-color: #0C0C31;
}
.QWidget {
	background-color: #091539;
}

QLineEdit {
    background-color: #041c3d;
    color: #ffffff;
    border: 1px solid #2a628f;
    padding: 4px 4px;
    border-radius: 4px;
}
QGroupBox {
    background-color: #041c3d;
    color: #ffffff;
    border: 1px solid #2a628f;
    padding: 0px 4px;
    border-radius: 4px;
}
QPushButton {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #51FCBB,
        stop:1 #4EE5D9
    );
    color: #000000;
    font-weight: bold;
    border: none;
    border-radius: 5px;
    padding: 5px 15px;
	margin: 5px;
}

QPushButton:hover {
    background-color: #CBFEEF
}

QSlider::handle{
 background-color: #45CACB;
}

QSlider::handle:hover{
 background-color: #51FDBA;
}


/* Popup lista */
QComboBox QAbstractItemView {
    background-color: #002949;
    color: #ffffff;
    border: 1px solid #2a628f;
    border-radius: 4px;
    padding: 4px;
    outline: none;   /* makni bijeli obrub */
}

/* Hover efekt na item */
QComboBox QAbstractItemView::item:hover {
    background-color: #15415A;
    color: #51FDBA;
    outline: none;
    border: none;
}

/* Selektirani item */
QComboBox QAbstractItemView::item:selected {
    background-color: #15415A;
    color: #51FDBA;
    outline: none;
    border: none;
}

QRadioButton::hover {
color: #51FDBA;
}
QRadioButton{
margin: 8px 0px;
}

QLabel#title1 {
	padding: 8px 16px
}
QLabel#title4 {
	margin: 8px 16px
}
QLabel#title3 {
	margin: 8px 16px
}


QSpinBox, QDateEdit, QTimeEdit, QComboBox{
    background-color: #002949;
    color: #ffffff;
    padding: 4px 15px;
}
QComboBox{
	padding: 2px 15px;
}

QSpinBox:hover,
QDateEdit:hover,
QTimeEdit:hover,
QComboBox:hover {
    color: #51FDBA;
}
</string>
